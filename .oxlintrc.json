// oxlint -- the control-flow enforcement STANDARDS-typescript.md names.
//
// This file is JSONC: oxlint parses comments here. It rejects unknown KEYS
// (including the `"//"` convention that works in package.json), so every note
// below is a real comment.
//
// WHY oxlint AND NOT eslint + typescript-eslint (measured 2026-07-30):
// The repo set pins typescript ^7.0.2 (commit b9f6630). typescript-eslint
// 8.65.0, the latest release, declares `typescript: >=4.8.4 <6.1.0` and does
// not merely warn -- it THROWS on load: typescript-eslint does not support
// TS 7. Tracking issue typescript-eslint#10940. Five approaches were tried and
// all failed: the rules package, the parser alone, a side-by-side TS 6.0.0-beta
// (estree API mismatch), TS 5.9.3 via nested symlink (estree still resolved
// 7.0.2), and npm-style overrides (bun ignores them for nested resolution).
//
// oxlint has NO typescript peer dependency -- its optional companion wants
// >=7.0.2001, i.e. it targets TS 7 rather than lagging it. It parses TS
// natively in Rust.
//
// TYPE-AWARE RULES ARE AVAILABLE HERE -- as of 2026-09-10 this no longer
// depends on eslint. The `oxlint-tsgolint` companion (pinned >=7.0.2001, i.e.
// it TARGETS TS 7 rather than lagging it) supplies the type information, and
// `oxlint --type-aware` evaluates the rules that need it. no-floating-promises
// is enabled below and observed firing; that was the headline reason to want
// eslint back, and it is now closed WITHOUT the typescript-eslint stack that
// cannot load against this repo's TS pin.
//
// The companion is a real dependency of the lint step, not an optional extra:
// without it `oxlint --type-aware` exits non-zero with "Failed to find
// tsgolint executable", which is the correct fail-closed behaviour -- the
// alternative is a lint run that silently skips its type-aware rules.
//
// ADD ESLINT BACK ALONGSIDE THIS when typescript-eslint ships TS 7 support,
// for the type-aware rules oxlint still lacks -- no-misused-promises is the
// notable one. Running both is the normal arrangement; the only reason it is
// not the case today is that eslint cannot LOAD, and a lint script that always
// throws teaches people to ignore the linter.
//
// PARITY WITH PYTHON -- deliberately the same numbers. A repo stricter in one
// language than the other teaches that the rule is arbitrary.
//   ruff C901    (max-complexity = 10)   -> complexity 10
//   ruff PLR1702 (max-nested-blocks = 3) -> max-depth 3
//   ruff RET505                          -> no-else-return
//   ruff B012 / E722                     -> no-empty, allowEmptyCatch off
//
// EVERY RULE BELOW WAS OBSERVED FIRING against TS 7 source before being written
// here. A configured rule is not an enforced rule: ruff's PLR1702 silently did
// nothing until `preview = true` was set, and that is the defect this file
// exists to avoid. tests/enforcement.test.ts re-asserts it on every run.
{
  "plugins": ["unicorn", "typescript", "oxc"],

  "categories": {
    "correctness": "error"
  },

  "rules": {
    // CYCLOMATIC COMPLEXITY = decision points + 1. Each of these adds one:
    // if, else-if, every switch case, for/while/do/for-of, catch, && || ??,
    // a ternary, an optional chain. A straight-line function scores 1.
    //
    // 10 is McCabe's original 1976 threshold and matches ruff C901.
    //
    // THE ARGUMENT IS NOT AESTHETIC. Complexity N means N independent paths,
    // so full branch coverage needs N test cases. Nobody writes 11 test cases
    // for one function -- so above the threshold the uncovered paths are
    // exactly where the bugs live, and they are invisible because the file has
    // tests.
    //
    // LIMIT: this counts BRANCHING, not SIZE. A 400-line function that
    // branches three times scores 4 and passes. It is a floor against tangled
    // control flow, not a ceiling on sprawl.
    "complexity": ["error", { "max": 10 }],

    // Nesting depth, which complexity does NOT capture -- a function can score
    // 8 (passing) while nested five levels deep (failing). You need both rules
    // or one leaks. 3 forces guard clauses and early returns, which is the
    // mechanical fix rather than a stylistic preference.
    "max-depth": ["error", { "max": 3 }],

    // SIZE, which neither complexity nor max-depth captures. This is the third
    // leg. Without it, a `createHookServer` function grew to 68
    // statements doing five distinct jobs -- method check, body read, signature
    // check, schema parse, forward -- and passed BOTH rules above, because it
    // branched shallowly and rarely. A 400-line function that branches three
    // times scores 4 on complexity and 1 on depth.
    //
    // 50 lines / 15 statements is the ceiling. Not a style preference: a
    // function that does not fit on one screen cannot be read as a unit, so a
    // reader reconstructs it from fragments and misses the interaction between
    // the top and the bottom. That is where the defects live.
    //
    // The fix is always the same and it is the point of the rule: if a function
    // needs a comment saying "now we do X", X is a function.
    //
    // skipBlankLines/skipComments are ON because this repo is deliberately
    // comment-dense; the limit is on CODE, not on explanation.
    "max-lines-per-function": [
      "error",
      { "max": 50, "skipBlankLines": true, "skipComments": true, "IIFEs": true }
    ],

    // One module, one job. A file past this is holding more than one
    // responsibility, and the import graph stops telling you where anything
    // lives. 500 CODE lines is the hard ceiling -- skipBlankLines/skipComments
    // are ON, so the limit is on code, not on this repo's dense explanation.
    // Same number as the Python twin: a repo stricter in one language teaches
    // that the rule is arbitrary.
    "max-lines": [
      "error",
      { "max": 500, "skipBlankLines": true, "skipComments": true }
    ],

    // A signature past four parameters is a struct that has not been named yet,
    // and every caller has to remember the order. Pass an options object.
    "max-params": ["error", { "max": 4 }],

    // One class, one job. A class past this is a module wearing a class.
    "max-nested-callbacks": ["error", { "max": 3 }],

    // `if (x) return a; else return b;` -> `if (x) return a; return b;`.
    // Removes one nesting level for free, which is why it sits next to
    // max-depth rather than in a style section.
    "no-else-return": "error",

    // An empty `catch {}` is a swallowed error: the failure still happened,
    // but nothing above ever learns of it. allowEmptyCatch is OFF on purpose --
    // if a throw really is expected, say so with a comment and a logged debug
    // line, not with silence.
    "no-empty": ["error", { "allowEmptyCatch": false }],
    "no-useless-catch": "error",

    // Structured logs or nothing. console.log bypasses the correlation id, the
    // level filter, and every sink in utils/logging.ts, so the one line you
    // most want during an incident is the one that is not in the file.
    "no-console": "error",

    "eqeqeq": ["error", "always", { "null": "ignore" }],
    "no-var": "error",
    "prefer-const": "error",

    // TYPE-AWARE. A dropped promise is the defect this repo is least able to
    // see any other way: the call happens, the failure happens, and nothing
    // above ever learns of it -- no rejection, no log line, no non-zero exit.
    // In an async entry point it also lets the process exit before the work
    // finishes, so the bug reproduces as "it worked locally, it did nothing in
    // prod" rather than as an error anyone can grep for.
    //
    // This rule needs TYPES, not just a syntax tree -- whether `f()` returns a
    // Promise is not visible in the source text. That is why it requires
    // `oxlint --type-aware` (npm run lint), which drives the `oxlint-tsgolint`
    // companion; the plain `oxlint` pass cannot evaluate it and SILENTLY SKIPS
    // it. A config entry alone is not enforcement: if the lint script loses
    // `--type-aware`, this rule stops running and nothing says so. That is
    // exactly the "configured but not enforced" failure the header of this
    // file exists to prevent, so tests/enforcement.test.ts asserts the rule
    // actually fires rather than trusting its presence here.
    //
    // This closes the gap the header calls out -- no-floating-promises was the
    // headline reason to want eslint back. oxlint-tsgolint targets TS 7
    // (it pins >=7.0.2001), so the rule is available here WITHOUT the
    // typescript-eslint stack that cannot load against this repo's TS pin.
    //
    // allowForKnownSafeCalls: node:test's `test`/`describe`/`suite` and the
    // hooks return a promise the RUNNER owns and awaits. Flagging them is a
    // false positive -- it fired 98 times across the five test files, all of
    // it noise. The allowance is scoped to those exact names from `node:test`
    // rather than disabling the rule in tests/, so a genuinely floating
    // promise inside a test body is still an error.
    "typescript/no-floating-promises": [
      "error",
      {
        "allowForKnownSafeCalls": [
          {
            "from": "package",
            "package": "node:test",
            "name": [
              "test",
              "it",
              "describe",
              "suite",
              "before",
              "after",
              "beforeEach",
              "afterEach"
            ]
          }
        ]
      }
    ],

    "typescript/no-explicit-any": "error",
    "typescript/no-non-null-assertion": "error"
  },

  "overrides": [
    // Scripts are CLIs; printing is their job.
    {
      "files": ["packages/*/scripts/**/*.ts"],
      "rules": { "no-console": "off" }
    },
    // Tests print diagnostics and construct deliberately-wrong values.
    //
    // max-lines-per-function is off here for ONE reason: a `describe` block is
    // a SUITE, not a function -- the linter cannot tell them apart, and
    // splitting a coherent suite to satisfy a line count makes the tests worse.
    // Individual `test` bodies are still expected to be short; that is a review
    // judgement rather than something this rule can express.
    //
    // max-lines stays ON. A test FILE past 300 lines is covering more than one
    // unit, which is the same "one module, one job" rule the source obeys.
    {
      "files": ["packages/*/tests/**/*.ts"],
      "rules": {
        "no-console": "off",
        "typescript/no-explicit-any": "off",
        "max-lines-per-function": "off"
      }
    }
  ],

  "ignorePatterns": ["**/node_modules/**", "**/dist/**", "coverage/**", "data/**"]
}
