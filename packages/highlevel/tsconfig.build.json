{
  // A build exists here because this is a library that
  // other apps npm-install. Node does not strip types inside node_modules, so
  // consumers need emitted JS plus .d.ts in dist/.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "rewriteRelativeImportExtensions": true,
    "declaration": true,
    "outDir": "dist",
    "rootDir": "src"
  },
  "include": ["src/**/*.ts"]
}
