{
  // The root project: one typecheck over every package, and what the editor
  // opens. Compiler options live in tsconfig.base.json, which each package's
  // own tsconfig.json also extends.
  "extends": "./tsconfig.base.json",
  "include": ["packages/*/src", "packages/*/tests", "packages/*/scripts"],
  "exclude": ["node_modules", "**/node_modules", "**/dist"]
}
